<!DOCTYPE html>
<html>
<body>

<input type="number" id="n">
<button onclick="sumEven()">Find Sum</button>

<p id="ans"></p>

<script>
function sumEven(){
 let n=document.getElementById("n").value;
 let sum=0;

 for(let i=2;i<=n;i+=2){
   sum+=i;
 }

 document.getElementById("ans").innerHTML="Sum = "+sum;
}
</script>

</body>
</html>
